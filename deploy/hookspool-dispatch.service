# hookspool-dispatch.service: the single deliverer (docs/architecture/ARCHITECTURE.md section 2).
# Install as /etc/systemd/system/hookspool-dispatch.service, then `systemctl daemon-reload`.
# Replace User/Group and the paths as in hookspool-intake.service.
#
# ReadWritePaths MUST list the state dir and the state_dir of EVERY script destination in config.toml that
# is outside it (a bobbin's processor keeps its state in <home>/bobbins/<instance>, already covered), and
# any other directory a script writes. ProtectSystem=strict makes everything else read-only, and a script
# that cannot write its journal fails every batch with a "config"-class error. Every listed path must exist
# before the unit starts (systemd fails with status 226/NAMESPACE otherwise): create them as in
# docs/operations/running.md. A directory under /home is writable only if it is listed here, because
# ProtectHome=read-only is set.
[Unit]
Description=hookspool dispatcher (coalesce, deliver, retry)
After=network.target
# No start limit: while ExecStartPre=check fails (an upgrade before `migrate`), systemd keeps retrying
# every RestartSec instead of giving up with "start request repeated too quickly".
StartLimitIntervalSec=0

[Service]
Type=simple
User=hookspool
Group=hookspool
Environment=HOOKSPOOL_HOME=/var/lib/hookspool
Environment=HOOKSPOOL_LOG=json
# `check` exits 2 on an older schema, so after an upgrade run `hookspool migrate` first (docs/operations/upgrading.md).
ExecStartPre=/usr/local/bin/hookspool check
ExecStart=/usr/local/bin/hookspool dispatch
ExecReload=/usr/local/bin/hookspool reload
Restart=always
RestartSec=2
# A second dispatcher exits 3 on the flock. Do not restart it in a loop; `systemctl status` shows it.
RestartPreventExitStatus=3
# On stop systemd kills the whole cgroup, scripts included. A batch cut off that way is retried
# (uncounted), and processors and journalled scripts replay their journal, so a stop never loses or repeats a result.
TimeoutStopSec=30
LimitNOFILE=4096

# Hardening. The dispatcher posts to the gateway and http destinations, runs the configured scripts,
# and runs the alert command. Scripts inherit these restrictions.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/hookspool
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
